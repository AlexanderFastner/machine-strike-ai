{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Browser code: keep the root's @types/node out, so Node APIs are an error here
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@data/*": [
        "../data/*"
      ],
      "@assets/*": [
        "../../assets/*"
      ],
      "@engine": [
        "../engine/src/index.ts"
      ],
      "@engine/*": [
        "../engine/src/*"
      ],
      "@ms/engine": [
        "../engine/src/index.ts"
      ],
      "@ms/ai": [
        "../ai/src/index.ts"
      ],
      "@ms/arena": [
        "../arena/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}